# LLM Configuration
# Google Gemini (Recommended)
# Get from: https://makersuite.google.com/app/apikey
GOOGLE_API_KEY=your_google_api_key_here

# Groq (Alternative - Fast inference)
# Get from: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Which provider to use: "google" or "groq"
LLM_PROVIDER=google

# Which model to use
# Google: gemini-1.5-flash, gemini-1.5-pro, gemini-pro
# Groq: llama-3.3-70b-versatile, mixtral-8x7b-32768, gemma2-9b-it
LLM_MODEL=gemini-1.5-flash

# Search
TAVILY_API_KEY=your_tavily_api_key_here

# Database
DATABASE_URL=postgresql://irium:irium_password@localhost:5432/irium_db

# Application
APP_ENV=development
LOG_LEVEL=INFO
MAX_UPLOAD_SIZE_MB=50
ALLOWED_FILE_TYPES=pdf,docx,txt

# Research Configuration
MAX_RETRIES=2
SEARCH_MAX_RESULTS=10

# PII Protection Configuration
# Policies: REDACT (default), BLOCK, MASK, LOG_ONLY
PII_DETECTION_ENABLED=true
PII_POLICY=REDACT

# Redis and Caching Configuration
REDIS_URL=redis://localhost:6379/0
REDIS_ENABLED=true
CACHE_DEFAULT_TTL=3600
CACHE_STABLE_TTL=86400
CACHE_VOLATILE_TTL=300

# Rate Limiting & Concurrency Controls
LLM_GLOBAL_CONCURRENCY=2
LLM_REQUESTS_PER_MINUTE=25
LLM_MAX_RETRY_ATTEMPTS=2
LLM_BACKOFF_BASE_SECONDS=1.5

# Per-Request Budget Limits
BUDGET_MAX_LLM_CALLS=5
BUDGET_MAX_TOOL_EXECUTIONS=3
BUDGET_MAX_RETRIES=2
BUDGET_MAX_GRAPH_ITERATIONS=2
BUDGET_TIMEOUT_SECONDS=30.0

# Groq Task Model Assignments
GROQ_MODEL_COMPLEX=openai/gpt-oss-120b
GROQ_MODEL_STANDARD=openai/gpt-oss-20b
GROQ_MODEL_ALTERNATIVE=qwen/qwen3.8-27b
